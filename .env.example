# Copia este archivo a .env.local y rellena solo lo que vayas a usar.
# Sin ninguna variable, el portal funciona en modo demostración: las fotos se quedan en el navegador,
# los precios salen de supabase/catalogo.json y el pago es simulado.

# URL pública del portal (para los enlaces de vuelta de Stripe). En Vercel se deduce sola.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase, proyecto en región UE (Frankfurt). Opcional en el prototipo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en el servidor (webhook, tareas programadas). Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe en modo test. Sin clave, el pago se simula.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Brevo, correos transaccionales. Sin clave, los correos se registran en el log del servidor sin enviarse.
BREVO_API_KEY=
BREVO_REMITENTE_EMAIL=
BREVO_REMITENTE_NOMBRE=

# Herramientas internas: el folleto plegable (/<idioma>/interno/folleto) y el muestrario de cartas
# (/<idioma>/interno/cartas). Con 1 se ven (sin indexar); sin ella dan 404. No la actives en producción.
HERRAMIENTAS_INTERNAS=

# Descarga del archivo de impresión (PDF) en la confirmación del pedido. Activa durante el prototipo,
# para las pruebas de impresión; ponla a 0 para la comercialización: el cliente ya no lo descarga.
# Se lee al compilar (NEXT_PUBLIC_): tras cambiarla, vuelve a compilar y desplegar.
NEXT_PUBLIC_DESCARGA_PDF=

# Solo en local: carpeta de compilación de Next (por defecto .next), para tener dos servidores de
# desarrollo a la vez. Usa un nombre .next-*, que git y ESLint ya ignoran.
NEXT_DIST_DIR=
