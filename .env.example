# Copia este archivo a .env.local y rellena solo lo que vayas a usar.
# Sin ninguna variable, el portal funciona en modo demostración: las fotos se quedan en el navegador,
# los precios salen de supabase/catalogo.json y el pago es simulado.

# URL pública del portal (para los enlaces de vuelta de Stripe). En Vercel se deduce sola.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase, proyecto en región UE (Frankfurt). Opcional en el prototipo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en el servidor (webhook, tareas programadas). Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe en modo test. Sin clave, el pago se simula.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Brevo, correos transaccionales. Sin clave, los correos se registran en el log del servidor sin enviarse.
BREVO_API_KEY=
BREVO_REMITENTE_EMAIL=
BREVO_REMITENTE_NOMBRE=

# Acceso privado mientras sea un prototipo. Con una clave, solo entra quien abre una vez
# https://<dominio>/?acceso=<clave>; ese navegador queda recordado 90 días. Sin ella, no hay bloqueo.
# Solo de servidor: ponla en Vercel, nunca en el repositorio. Cambiarla deja fuera a todos.
CLAVE_ACCESO=

# Buscadores. Sin ella (o con 0), ningún buscador indexa el portal: robots.txt lo prohíbe y cada
# respuesta lleva noindex. Para la comercialización, 1. Se lee al compilar.
PERMITIR_INDEXAR=

# Herramientas internas: el folleto plegable (/<idioma>/interno/folleto) y el muestrario de cartas
# (/<idioma>/interno/cartas). Con 1 se ven (sin indexar); sin ella dan 404. No la actives en producción.
HERRAMIENTAS_INTERNAS=

# Descarga del archivo de impresión (PDF) en la confirmación del pedido. Activa durante el prototipo,
# para las pruebas de impresión; ponla a 0 para la comercialización: el cliente ya no lo descarga.
# Se lee al compilar (NEXT_PUBLIC_): tras cambiarla, vuelve a compilar y desplegar.
NEXT_PUBLIC_DESCARGA_PDF=

# Subida colaborativa: dirección del servicio que guarda, cifradas, las fotos que manda la familia
# por el enlace del mazo (la función «colaboracion» de Supabase:
# https://<ref>.supabase.co/functions/v1/colaboracion). Sin ella, no se ofrece pedir fotos por enlace.
# Se lee al compilar (NEXT_PUBLIC_). No es secreta: el navegador la usa directamente.
NEXT_PUBLIC_COLABORACION_URL=

# Solo en desarrollo y pruebas: con 1, la propia web sirve ese servicio en /api/colaboracion y guarda
# los paquetes cifrados en .colaboracion-local/ (fuera de git). Úsala con
# NEXT_PUBLIC_COLABORACION_URL=/api/colaboracion. En producción, vacía: la ruta responde 404.
COLABORACION_LOCAL=

# Secreto que comparten el portal y el servicio de la subida colaborativa: los enlaces para pedir
# fotos solo se crean desde el portal (ruta /api/enlaces, detrás del acceso privado), que lo manda
# en cada petición. Va en Vercel (solo servidor) y, con el mismo valor, en los secretos de la
# función de Supabase (supabase secrets set COLABORACION_CLAVE_SERVICIO=…). Largo y aleatorio.
# Sin él, el servicio no deja crear enlaces. En local es opcional (sin él, no se comprueba).
COLABORACION_CLAVE_SERVICIO=

# Solo en local: carpeta de compilación de Next (por defecto .next), para tener dos servidores de
# desarrollo a la vez. Usa un nombre .next-*, que git y ESLint ya ignoran.
NEXT_DIST_DIR=
