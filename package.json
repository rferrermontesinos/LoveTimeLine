{
  "name": "cartas-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Portal para crear un mazo de cartas personalizado con fotos y fechas (prototipo).",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "print:sample": "tsx scripts/print-sample.ts",
    "instrucciones:pdf": "tsx scripts/instrucciones-pdf.ts",
    "db:seed": "tsx scripts/seed-sql.ts",
    "fixtures": "tsx scripts/fixtures.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "exifr": "7.1.3",
    "heic2any": "0.0.4",
    "idb-keyval": "6.3.0",
    "konva": "10.9.1",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-easy-crop": "6.2.4",
    "react-konva": "19.3.2",
    "stripe": "23.1.0",
    "tus-js-client": "4.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
